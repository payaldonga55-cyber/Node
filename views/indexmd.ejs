<form action="/createData">
    <input type="hidden" name="id" id="" value="<%=(userData)?userData._id:""%>">
    Name:<input type="text" name="name" id="" value="<%=(userData)?userData.name:""%>">
    <br><br>
    Age:<input type="number" name="age" id="" value="<%=(userData)?userData.age:""%>">
    <br><br>
    <input type="submit" name="" id="">
</form>
<table border="1">
    <tr>
        <td>Name</td>
        <td>Age</td>
        <td>DELETE</td>
        <td>UPDATE</td>
    </tr>
    <%
        data.map((i,index)=>{
    %>
            <tr>
                <td><%=i.name%></td>
                <td><%=i.age%></td>
                <td>
                    <button>
                        <a href="/deleteData/<%=i._id%>">Delete</a>
                    </button>
                </td>
                <td>
                    <button>
                        <a href="/editData/<%=i._id%>">Update</a>
                    </button>
                </td>
            </tr>
    <%
        })
    %>
   
</table>