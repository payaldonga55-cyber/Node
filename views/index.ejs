<form action="/createData">
    name:-<input type="text" name="name" id="" value="<%=(editData)?editData.name:""%>">
    <br><br>
    age:-<input type="number" name="age" id="" value="<%=(editData)?editData.age:""%>">
    <br><br>
    <input type="submit" name="" id="">  
</form>
<table border="=1">
    <tr>
        <td>Name</td>
        <td>Age</td>
        <td>DELETE</td>
        <td>UPDATE</td>
    </tr>
    <%
        arr.map((i,index)=>{
    %>
    <tr>
        <td><%=i.name%></td>
        <td><%=i.age%></td>
        <td>
            <!-- params  -->
            <button><a href="/deleteData/<%=index%>"">DELETE</a></button>
        </td>
        <td>
            <!-- query -->
             <button><a href="/editData?editId=<%=index%>">UPDATE</a></button>
        </td>
    </tr>
    <%
        })
    %>
    
</table>