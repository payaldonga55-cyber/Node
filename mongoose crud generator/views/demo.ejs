<form action="/createData" method="post">
    <input type="hidden" name="id" id="" value="<%= (editData) ? editData._id : "" %>">
    name <input type="text" name="name" id="" value="<%= (editData) ? editData.name : "" %>">
    <br> <br>
    age <input type="number" name = "age" id="" value="<%= (editData) ? editData.age : "" %>">
    <br> <br>
    <button type="submit">Submit</button>
</form>
<table border="1">
    <tr>
        <td>NAme</td>
        <td>Age</td>
        <td>DELETE</td>
        <td>UPDATE</td>
    </tr>
    <%
        allData.map((i , index) => {
    %>
            <tr>
                <td><%= i.name %></td>
                <td><%= i.age %></td>
                <td>
                    <button><a href="/deleteData/<%= i._id %>">Delete</a></button>
                </td>
                <td>
                    <button><a href="/editData/<%= i._id %>">Update</a></button>
                </td>
            </tr>
    <%
        })
    %>
</table>