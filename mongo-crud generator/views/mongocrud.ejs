<form action="/crud/createData">
    <input type="hidden" name="id" id="" value="<%= (userData) ? userData._id : "" %>">
    name = <input type="text" name="name" id="" value="<%= (userData) ? userData.name : "" %>">
    <br><br>
    age = <input type="number" name="age" id="" value="<%= (userData) ? userData.age : "" %>">
    <br><br>
    submit = <input type="submit" name="" id="">
</form>


<table border="1">
    <tr>
        <td>Name</td>
        <td>Age</td>
        <td>DELETE</td>
        <td>UPDATE</td>
    </tr>
    <%
        data.map(( i , index ) => {
    %>
            <tr>
                <td><%= i.name %></td>
                <td><%= i.age %></td>
                <td>
                    <button><a href="/crud/deleteData/<%= i._id %>">DELETE</a></button>
                </td>
                <td>
                    <button><a href="/crud/editData/<%= i._id %>">UPDATE</a></button>
                </td>
            </tr>
    <%
        })
    %>
</table>